import Tests.X691Decode
import Asn1.X691.Enc

/-! The PER encoder (`Asn1/X691/Enc.lean`) on X.691 Annex A (A.1–A.4): each value, decoded from the
encoding the standard prints, encodes back to exactly those octets, in its variant and in the
canonical one (the values of Annex A are canonical). -/

open Asn1 Asn1.X680 Asn1.X691 Asn1.X691.DecodeTest

namespace Asn1.X691.EncodeTest

/-- Decode, then encode with the same variant; `true` when the octets come back. -/
def roundtrip (src typ hex : String) (v : Variant) : Bool :=
  let E := envOf src
  let os := hexOctets hex
  match E.head? with
  | some m => match decode E v 400 m (.ref typ) os with
    | .ok x => match encode E v 400 m (.ref typ) x with
      | .ok os' => os' == os
      | .error _ => false
    | .error _ => false
  | none => false

